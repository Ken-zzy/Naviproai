{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
		"name": "NaviProAI API",
		"description": "Postman collection for the NaviProAI backend API. This collection covers all major features including Authentication, AI-powered Roadmap Generation, Chat, Task Management, Streaks, and Notifications.\n\n**Setup:**\n1. Import this collection into Postman.\n2. The `baseUrl` variable is pre-configured for the production environment. You can change it in the collection's 'Variables' tab if you are running locally.\n3. Run the **Authentication > Login User** request with valid credentials for a verified user. This will automatically save the JWT to the `jwt_token` collection variable.\n4. All other protected requests will automatically use this token for authentication.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "0"
	},
	"item": [
		{
			"name": "Authentication",
			"description": "Endpoints for user registration, login, and verification.",
			"item": [
				{
					"name": "Register New User",
					"id": "e1a4f5b6-7c8d-4e9f-a1b2-c3d4e5f6a7b8",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response should contain a success message\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Registration successful. Please check your email to verify your account.\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"testuser+[{$randomInt}]@example.com\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Registers a new user. A verification email will be sent to the provided email address. The email includes a token needed for the `Verify Email` endpoint.\n\nNote: `[{$randomInt}]` is used to generate a unique email for each registration attempt."
					},
					"response": []
				},
				{
					"name": "Login User",
					"id": "f2b5g6c7-8d9e-5g0h-b2c3-d4e5f6a7b8c9",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response should contain an access token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"access_token\");",
									"    pm.expect(jsonData.access_token).to.be.a('string');",
									"});",
									"",
									"pm.test(\"Set JWT as collection variable\", function() {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.access_token) {",
									"        pm.collectionVariables.set(\"jwt_token\", jsonData.access_token);",
									"        console.log(\"JWT Token set successfully.\")",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"verifieduser@example.com\",\n    \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Logs in a **verified** user and returns a JWT `access_token`. \n\nThe tests for this request will automatically save the token to the `jwt_token` collection variable, which is used by all other protected endpoints."
					},
					"response": []
				},
				{
					"name": "Verify Email",
					"id": "a3c6h7d8-9e0f-6h1i-c3d4-e5f6a7b8c9d0",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response should contain a success message\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Email verified successfully\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/verify-email?token=YOUR_VERIFICATION_TOKEN",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"verify-email"
							],
							"query": [
								{
									"key": "token",
									"value": "YOUR_VERIFICATION_TOKEN",
									"description": "The token received in the user's verification email."
								}
							]
						},
						"description": "Verifies a user's email address using the token sent to them upon registration. You must replace `YOUR_VERIFICATION_TOKEN` with a valid token."
					},
					"response": []
				}
			]
		},
		{
			"name": "AI",
			"description": "Endpoints for interacting with the Navi AI assistant.",
			"item": [
