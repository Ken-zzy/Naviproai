								"{{baseUrl}}"
							],
							"path": [
								"ai",
								"generate-roadmap"
							]
						},
						"description": "Generates a personalized learning roadmap based on the user's desired role and current skill level. This will create or update the roadmap associated with the authenticated user."
					},
					"response": []
				},
				{
					"name": "Chat with Navi",
					"id": "c5e8j9f0-1g2h-8j3k-e5f6-a7b8c9d0e1f2",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response should contain a reply\", function () {",
									"    var jsonData = pm.response.json();",
									"    // The AI response shape might vary, check for common properties.",
									"    const hasReply = jsonData.hasOwnProperty('reply') || jsonData.hasOwnProperty('text') || jsonData.hasOwnProperty('content');",
									"    pm.expect(hasReply).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"What is the best way to learn about microservices?\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/ai/chat",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"ai",
								"chat"
							]
						},
						"description": "Sends a message to the Navi AI assistant and gets a contextual response based on the user's progress and goals. The conversation history is maintained on the backend."
					},
					"response": []
				}
			]
		},
		{
			"name": "Roadmap & Tasks",
			"description": "Endpoints for managing and interacting with the user's learning roadmap and daily tasks.",
			"item": [
				{
					"name": "Get Daily Task",
					"id": "d6f9k0g1-2h3i-9k4l-f6a7-b8c9d0e1f2g3",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response should be a task object or null\", function () {",
									"    try {",
									"        var jsonData = pm.response.json();",
									"        if (jsonData) {",
									"            pm.expect(jsonData).to.have.property('task_id');",
									"            pm.expect(jsonData).to.have.property('title');",
									"            pm.expect(jsonData.completed).to.be.false;",
									"        }",
									"    } catch (e) {",
									"        // Handle empty response body for the 'null' case",
									"        pm.expect(pm.response.text()).to.be.empty;",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/roadmap/daily-task",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"roadmap",
								"daily-task"
							]
						},
						"description": "Retrieves the next uncompleted daily task from the user's roadmap. Returns the task object or `null` if all tasks are completed or no roadmap exists."
					},
					"response": []
				},
				{
					"name": "Complete Task",
					"id": "e7g0l1h2-3i4j-0l5m-a7b8-c9d0e1f2g3h4",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response should be the updated roadmap\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('months');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/roadmap/complete-task/:taskId",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"roadmap",
								"complete-task",
								":taskId"
