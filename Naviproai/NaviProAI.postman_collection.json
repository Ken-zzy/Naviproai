							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"targetRole\": \"Senior Backend Engineer\",\n    \"currentLevel\": \"Junior Developer\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/ai/generate-roadmap",
